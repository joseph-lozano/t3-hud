#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
swift build -c release
binary_dir="$(swift build -c release --show-bin-path)"
app="$PWD/dist/T3 HUD.app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp "$binary_dir/T3HUD" "$app/Contents/MacOS/T3HUD"
cp Resources/Info.plist "$app/Contents/Info.plist"
cp Resources/T3Mark.png Resources/T3-MIT-LICENSE.txt Resources/NotificationBridge.js "$app/Contents/Resources/"
signing_identity="${T3HUD_SIGNING_IDENTITY:-}"
if [[ -z "$signing_identity" && -f .signing-identity ]]; then
    signing_identity="$(cat .signing-identity)"
fi
if [[ -n "$signing_identity" ]]; then
    # Fail if this identity is unavailable; never silently replace a signed build
    # with an ad-hoc identity and invalidate its Keychain access again.
    codesign --force --options runtime --timestamp --sign "$signing_identity" "$app"
else
    codesign --force --sign - "$app"
fi
codesign --verify --strict "$app"
printf '%s\n' "$app"
