#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
build_args=(-c release)
if [[ -n "${T3HUD_ARCH:-}" ]]; then
    [[ "$T3HUD_ARCH" == arm64 ]] || { echo 'T3HUD_ARCH must be arm64.' >&2; exit 1; }
    build_args+=(--arch "$T3HUD_ARCH")
fi
if [[ -n "${T3HUD_VERSION:-}" && ! "$T3HUD_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo 'T3HUD_VERSION must be three numbers, for example 0.1.0.' >&2
    exit 1
fi
if [[ -n "${T3HUD_BUILD_NUMBER:-}" && ! "$T3HUD_BUILD_NUMBER" =~ ^[1-9][0-9]*$ ]]; then
    echo 'T3HUD_BUILD_NUMBER must be a positive integer.' >&2
    exit 1
fi
swift build "${build_args[@]}"
binary_dir="$(swift build "${build_args[@]}" --show-bin-path)"
app="$PWD/dist/T3 HUD.app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp "$binary_dir/T3HUD" "$app/Contents/MacOS/T3HUD"
cp Resources/Info.plist "$app/Contents/Info.plist"
if [[ -n "${T3HUD_VERSION:-}" ]]; then
    /usr/libexec/PlistBuddy -c "Set :CFBundleShortVersionString $T3HUD_VERSION" "$app/Contents/Info.plist"
fi
if [[ -n "${T3HUD_BUILD_NUMBER:-}" ]]; then
    /usr/libexec/PlistBuddy -c "Set :CFBundleVersion $T3HUD_BUILD_NUMBER" "$app/Contents/Info.plist"
fi
cp Resources/T3Mark.png Resources/T3-MIT-LICENSE.txt Resources/NotificationBridge.js Resources/ActivityBridge.js "$app/Contents/Resources/"
signing_identity="${T3HUD_SIGNING_IDENTITY:-}"
if [[ -z "$signing_identity" && -f .signing-identity ]]; then
    signing_identity="$(cat .signing-identity)"
fi
if [[ -n "$signing_identity" ]]; then
    # Fail if this identity is unavailable; never silently replace a signed build
    # with an ad-hoc identity and invalidate its Keychain access again.
    codesign --force --options runtime --timestamp --sign "$signing_identity" "$app"
else
    codesign --force --sign - "$app"
fi
codesign --verify --strict "$app"
printf '%s\n' "$app"
